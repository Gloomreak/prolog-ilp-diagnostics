# Скопируйте в .env и при необходимости раскомментируйте.
# Полный путь к swipl (нужен, если swipl нет в PATH):
# SWIPL_PATH=C:\Program Files\swipl\bin\swipl.exe
# Максимальное время одного запуска Prolog, секунд:
# ILP_TIMEOUT_SECONDS=300
# Не удалять временные файлы запроса/ответа (для отладки):
# ILP_KEEP_TEMP=1
